# Copy to .env.local for local development.
# Names only — do not commit real secrets.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (local: pnpm db:start && pnpm db:status)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI text (Phase 13+)
GEMINI_API_KEY=
# Local/e2e only — never enable in production
INKORA_AI_MOCK=false

# Optional AI image (Phase 15+)
HF_TOKEN=
IMAGE_GENERATION_ENABLED=false
